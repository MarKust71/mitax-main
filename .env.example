# Copy to .env and fill in. Production values belong in the hosting provider's
# environment settings (or .env.production.local), never in the repository.

# --- PostgreSQL ---
# Connection used by the application at runtime (least-privileged user).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# require (verified TLS) | disable
# Optional CA certificate (PEM) for DB_SSL=require with a self-signed server certificate.
# DB_SSL_CA=
DB_SSL=require

# Admin user, used only for migrations / schema changes (never by the running app).
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
